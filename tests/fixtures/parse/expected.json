      "Config._check": "function",
      "BaseClient": "class",
      "BaseClient.__init__": "function",
      "BaseClient.request": "function",
      "BaseClient.close": "function",
      "Client": "class",
      "Client.request": "function",
      "Client.get": "function",
      "Client.post": "function",
      "Client._retry": "function",
      "Client.user_agent": "function",
      "Client.__repr__": "function",
      "Client.Pool": "class",
      "Client.Pool.acquire": "function",
      "Client.Pool.release": "function",
      "build_client": "function",
      "_normalise": "function",
      "parse_payload": "function",
      "parse_payload._attempt": "function",
      "fetch_all": "function",
      "main": "function",
      "Registry": "class",
      "Registry.register": "function",
      "Registry.resolve": "function"
    },
    "excluded_by_design": {
      "Config.timeout": "class-level annotated attribute, not a module constant",
      "timeout": "same attribute, unqualified",
      "json": "an imported module is a reference, not a definition here",
      "AnyValue": "an import alias is a reference, not a definition here"
    }
  },

